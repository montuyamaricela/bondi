model RealtimeLease {
  id        String   @id @default(cuid())
  topic     String   @unique
  userId    String
  sessionId String
  expiresAt DateTime
  presenceSequence Int @default(0)
  presenceExpiresAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  typing    TypingLease[]

  @@index([userId, expiresAt])
  @@index([userId, presenceExpiresAt])
  @@index([sessionId])
}

model TypingLease {
  leaseId   String
  matchId   String
  viewId    String @db.Uuid
  sequence  Int
  expiresAt DateTime
  lease     RealtimeLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([leaseId, matchId, viewId])
  @@index([matchId, expiresAt])
}
