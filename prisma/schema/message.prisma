model Message {
  id        String       @id @default(cuid())
  matchId   String
  senderId  String
  content   String       @db.Text
  type      MessageType  @default(TEXT)
  clientRequestId String?

  // File attachment fields (optional)
  fileUrl   String?
  fileKey   String?      // UploadThing key for deletion
  fileName  String?
  fileSize  Int?
  fileType  String?      // MIME type (e.g., "image/jpeg", "application/pdf")

  createdAt DateTime     @default(now())
  readAt    DateTime?

  // Relations
  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deliveries MessageDelivery[]

  @@index([matchId])
  @@index([matchId, createdAt, id])
  @@index([senderId])
  @@index([createdAt])
  @@unique([senderId, matchId, clientRequestId])
}

model MessageDelivery {
  messageId String
  userId String
  notificationId String?
  excludedSocketId String?
  // A live hint was attempted, or communication ended; this is not a read receipt.
  completedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("date_trunc('milliseconds', (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'))"))
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@id([messageId, userId])
  @@index([userId, completedAt, createdAt])
  @@index([notificationId])
  @@index([completedAt, nextAttemptAt, createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}
