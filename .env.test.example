# Unit/schema-only example. Application E2E requires the prepared native Supabase
# environment; see docs/supabase-testing.md and copy its values to .env.test.local.
# Use disposable test data, never production data.
DATABASE_URL="postgresql://user:password@localhost:5432/bondi_test?schema=public"
# Optional explicit migration connection; use the same disposable target, never production.
# DIRECT_URL="postgresql://user:password@localhost:5432/bondi_test?schema=public"
BETTER_AUTH_SECRET="synthetic-local-e2e-secret-not-for-production"
BETTER_AUTH_URL="http://127.0.0.1:3100"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3100"
UPLOADTHING_TOKEN=""
