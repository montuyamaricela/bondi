# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bondi_db?schema=public"
# Optional direct/session connection for Prisma CLI; required when DATABASE_URL uses transaction pooling.
# DIRECT_URL="postgresql://user:password@localhost:5432/bondi_db?schema=public"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Auth/app origins above must be explicit in production.
# Next owns listener options: npm run dev -- --hostname 127.0.0.1 --port 3000

# Supabase Database + Realtime: configure the target and import the signing key explicitly.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# SUPABASE_SECRET_KEY=server-only-secret-key
# SUPABASE_SIGNING_KEYS_PATH=/private/path/signing_keys.json
# Only project URL and publishable key may use NEXT_PUBLIC_; signing/secret keys stay server-only.
# Do not put a secret/service-role key or JWT signing material in NEXT_PUBLIC_ values.

# UploadThing (File Upload)
UPLOADTHING_TOKEN=""

# Optional: Email Service (e.g., Resend, SendGrid)
# EMAIL_FROM=""
# EMAIL_API_KEY=""
