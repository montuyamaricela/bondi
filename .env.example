# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bondi_db?schema=public"
# Optional direct/session connection for Prisma CLI; required when DATABASE_URL uses transaction pooling.
# DIRECT_URL="postgresql://user:password@localhost:5432/bondi_db?schema=public"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Auth/app origins above must be explicit in production. Optional listener settings:
# HOSTNAME="localhost"
# PORT="3000"

# Supabase Database + Realtime migration (#74): use approved project settings when #77 lands.
# Only project URL and publishable key may use NEXT_PUBLIC_; signing/secret keys stay server-only.
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Do not put a secret/service-role key or JWT signing material in NEXT_PUBLIC_ values.

# Socket.IO (same origin as the combined Next + Socket.IO server)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
# Used only by the optional standalone socket server
SOCKET_PORT="3001"

# UploadThing (File Upload)
UPLOADTHING_TOKEN=""

# Optional: Email Service (e.g., Resend, SendGrid)
# EMAIL_FROM=""
# EMAIL_API_KEY=""
