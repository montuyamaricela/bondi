{
  "name": "bondi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/unit/*.test.tsx tests/harness/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:supabase": "playwright test --config=playwright.supabase.config.ts",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:keys:prepare": "node scripts/prepare-realtime-keys.mjs --confirm-project bondi-integration",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:test:prepare": "tsx scripts/prepare-supabase-test.ts --confirm-project bondi-integration",
    "check": "node scripts/check.mjs",
    "check:feature": "npm run check && npm run test:e2e",
    "check:harness": "node scripts/check-harness.mjs",
    "audit:critical": "npm audit --audit-level=critical",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "cities:import": "tsx scripts/import-city-catalog.ts",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:validate": "lefthook validate",
    "check:realtime": "node scripts/check-realtime-retirement.mjs",
    "migration:local": "tsx scripts/migration/local-cli.ts",
    "migration:schema": "tsx scripts/migration/schema-cli.ts",
    "migration:fixtures": "tsx scripts/migration/fixtures-cli.ts",
    "migration:accounts": "tsx scripts/migration/accounts-cli.ts",
    "migration:transfer": "tsx scripts/migration/transfer-cli.ts",
    "migration:qualify": "tsx scripts/migration/qualify-cli.ts",
    "migration:build": "tsx scripts/migration/build-cli.ts",
    "migration:delivery": "tsx scripts/migration/delivery-cli.ts",
    "test:migration": "tsx scripts/migration/test-cli.ts",
    "migration:guards": "tsx scripts/migration/guards-cli.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "^5.90.5",
    "@uploadthing/react": "^7.3.3",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "6.2.10",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.65.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "^6.18.0",
    "supabase": "2.122.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "packageManager": "npm@10.9.2"
}
